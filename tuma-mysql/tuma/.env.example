# Copy to .env.local and fill in. Never commit the filled-in file.
#
# This file is a TEMPLATE and is tracked in git — the repository is public, so
# anything written here is published. Nothing reads it at runtime: put real
# values in .env.local (gitignored) or in your host's environment settings.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. SSL is required and already configured in
# lib/db.ts.
#
# On Supabase, take the *transaction pooler* string (port 6543) from the
# dashboard's Connect panel — not the direct 5432 connection, which is
# IPv6-only on newer projects and holds a real backend connection per
# instance. URL-encode the password if it contains @ # / or ?.
DATABASE_URL=postgresql://postgres.raqshdregiclrgyjtyrb:tuma@khame23@aws-0-eu-central-1.pooler.supabase.com:6543/postgres


# Pool size per serverless instance. Keep it small; warm instances reuse it.
DB_CONNECTION_LIMIT=3

# ── Admin auth (NextAuth + Google) ──────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=3hcGoBV+GDA0oLGVaQR4zKVZhHsAww4pA4KfO8psnXY=
# The site's own origin, with no trailing slash — a trailing slash produces
# doubled callback URLs and a redirect_uri_mismatch from Google. Vercel infers
# this, so you can leave it unset there.
NEXTAUTH_URL=https://tuma-ten.vercel.app

GOOGLE_CLIENT_ID=617040227957-nq61kc5qrhqmk8u8k0n7ve5peuuvod0t.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# Comma-separated allowlist. A valid Google account alone is NOT enough —
# lib/auth.ts rejects anyone not on this list before a session is created.
ADMIN_EMAILS=raymondmutiso40@egmail.com

# ── M-Pesa (Safaricom Daraja) ───────────────────────────────────────────────
# "production" hits api.safaricom.co.ke; anything else uses the sandbox.
MPESA_ENV=sandbox

MPESA_CONSUMER_KEY=huzjNqE8IKHz3KKkxJZiuahizBy9NQ1D3NFTeXA8f0AeYG9m
MPESA_CONSUMER_SECRET=8fZIS8ZyQjVwso1IBDC3S8a81xCqkg6boXumUiR5RFv1yhtGaBw7OPgZThIXMFJ6
MPESA_SHORTCODE=174379
MPESA_PASSKEY=fb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Where Safaricom posts the STK result. This must be a public HTTPS URL
# pointing at /api/mpesa/callback — nothing marks a booking paid without it.
# Include the token below so the endpoint can reject forged calls.
# Locally, expose your dev server with a tunnel (e.g. ngrok) and use that host.
MPESA_CALLBACK_URL=https://tuma-ten.vercel.app/api/mpesa/callback?token=b33d075da6f206e167ab703167e0aeb4e127d521bcad747cbe924b18905e1eba

# Shared secret checked against the ?token= on the callback URL above. Leave
# unset only if you accept that anyone who guesses a CheckoutRequestID can
# mark a booking as paid.
MPESA_CALLBACK_SECRET=b33d075da6f206e167ab703167e0aeb4e127d521bcad747cbe924b18905e1eba
